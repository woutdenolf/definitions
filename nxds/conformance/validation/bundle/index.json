 "codes": {
  "BUNDLE": {
   "doc": "the bundle used, when not taken from the file",
   "exceptions": {},
   "partial": "kept",
   "path": "the root",
   "severity": "I",
   "tier": "M"
  },
  "CLASS": {
   "doc": "a group assigned by an exact name has a class that does not fit",
   "exceptions": {},
   "partial": "kept",
   "path": "the object",
   "severity": "E",
   "tier": "M"
  },
  "CONSTRAINT": {
   "doc": "at_least_one_of, exactly_one_of, at_most_one_of, all_or_none; attribute length or rank",
   "exceptions": {},
   "partial": "missing",
   "path": "the group; for attribute length and rank the object that owns the attribute",
   "severity": "E",
   "tier": "M"
  },
  "DEPRECATED": {
   "doc": "a deprecated member or value is used",
   "exceptions": {},
   "partial": "kept",
   "path": "the object",
   "severity": "W",
   "tier": "M"
  },
  "ENUM": {
   "doc": "a value outside a closed enumeration",
   "exceptions": {},
   "partial": "kept",
   "path": "the object",
   "severity": "E",
   "tier": "S"
  },
  "ENUM-OPEN": {
   "doc": "a value outside an open enumeration",
   "exceptions": {},
   "partial": "kept",
   "path": "the object",
   "severity": "W",
   "tier": "S"
  },
  "INCOMPLETE": {
   "doc": "partial mode: a finding that may go away once writing is done; the message names the replaced code",
   "exceptions": {},
   "partial": "kept",
   "path": "as the replaced code",
   "severity": "I",
   "tier": "M"
  },
  "LINK": {
   "doc": "a dangling link, or a link whose object is not assigned to its target member",
   "exceptions": {},
   "partial": "dangling",
   "path": "the link",
   "severity": "E",
   "tier": "M"
  },
  "MISSING": {
   "doc": "fewer objects than min (one finding per member and parent)",
   "exceptions": {},
   "partial": "always",
   "path": "the parent",
   "severity": "E",
   "tier": "M"
  },
  "NAME": {
   "doc": "a name outside the name rules",
   "exceptions": {},
   "partial": "kept",
   "path": "the object",
   "severity": "W",
   "tier": "M"
  },
  "NO-CLASS": {
   "doc": "a group (not the root) has no class",
   "exceptions": {},
   "partial": "always",
   "path": "the object",
   "severity": "W",
   "tier": "M"
  },
  "NO-DEFINITION": {
   "doc": "no group is dispatched (not reported with expect); E with expect: fewer groups follow the expected definition than it requires",
   "exceptions": {
    "expect": "E"
   },
   "partial": "always",
   "path": "the root",
   "severity": "I",
   "tier": "S"
  },
  "RECOMMENDED": {
   "doc": "a recommended member is absent",
   "exceptions": {},
   "partial": "always",
   "path": "the parent",
   "severity": "W",
   "tier": "M"
  },
  "REF": {
   "doc": "a role or names_child attribute names no child, or a child of the wrong kind",
   "exceptions": {},
   "partial": "always",
   "path": "the attribute",
   "severity": "E",
   "tier": "M"
  },
  "SHAPE": {
   "doc": "rank, dimension or symbol; W for a scalar against length 1, and for symbol conflicts in an entry marked stopped (Q10)",
   "exceptions": {
    "scalar_against_length_1": "W",
    "stopped_entry": "W"
   },
   "partial": "growing",
   "path": "the object; the entry (or /) for symbols",
   "severity": "E",
   "tier": "M"
  },
  "SKIPPED": {
   "doc": "a check not done (read error, unknown feature, tier F)",
   "exceptions": {},
   "partial": "kept",
   "path": "the object",
   "severity": "I",
   "tier": "M"
  },
  "TOO-MANY": {
   "doc": "more objects than max; max 0 means forbidden",
   "exceptions": {},
   "partial": "kept",
   "path": "the parent",
   "severity": "E",
   "tier": "M"
  },
  "TYPE": {
   "doc": "storage type not accepted, or a value check failed (NX_POSINT, NX_BOOLEAN, NX_DATE_TIME; tier S); a definition that is not one text value",
   "exceptions": {},
   "partial": "kept",
   "path": "the object",
   "severity": "E",
   "tier": "M"
  },
  "UNDECLARED": {
   "doc": "an object no member declares; E with undeclared: error",
   "exceptions": {
    "undeclared_error": "E"
   },
   "partial": "kept",
   "path": "the object",
   "severity": "I",
   "tier": "M"
  },
  "UNITS": {
   "doc": "units attribute absent, not understood, or of a dimension outside the category",
   "exceptions": {},
   "partial": "absent",
   "path": "the dataset",
   "severity": "W",
   "tier": "M"
  },
  "UNKNOWN-CLASS": {
   "doc": "a class not in the bundle; its content is undeclared",
   "exceptions": {},
   "partial": "kept",
   "path": "the group",
   "severity": "W",
   "tier": "M"
  },
  "UNKNOWN-DEFINITION": {
   "doc": "a definition that is not an application definition of the bundle",
   "exceptions": {},
   "partial": "kept",
   "path": "the definition dataset",
   "severity": "W",
   "tier": "S"
  },
  "UNKNOWN-RELEASE": {
   "doc": "a release the validator does not have",
   "exceptions": {},
   "partial": "kept",
   "path": "the root",
   "severity": "W",
   "tier": "M"
  }
 },
 "decisions": {
  "Q1": "Occurrence defaults and precedence (minOccurs, optional, recommended)",
  "Q10": "A standard way to mark an entry as aborted or incomplete",
  "Q11": "Ids: a dataset member and a group member may share an id",
  "Q12": "The rules of NXdata and NXobject written in the manual become roles and names_child (T13): DATA named by @signal, AXISNAME by @axes, @auxiliary_signals names datasets, @default names a group; AXISNAME_indices and the other rules of the manual are not checked",
  "Q13": "Reserved prefixes and suffixes (not checked: NXDS states no rule for them)",
  "Q14": "A free-named member of a specialisation applies to every object it matches (a free-named NXdata member of an entry specialisation applies to every NXdata group of that entry)",
  "Q2": "Attributes and links are required by default in an application definition",
  "Q3": "Placeholder characters; may a placeholder be empty; template priority",
  "Q4": "Refinement: override or extend; subclasses where a superclass is expected; name-fit",
  "Q5": "Are shapes binding; scope of a symbol",
  "Q6": "Severities of findings",
  "Q7": "NeXus type to storage types",
  "Q8": "Links: by storage or by content; is a copy acceptable",
  "Q9": "Dispatch: entry points, definition, NXsubentry, root-level members"
 },
