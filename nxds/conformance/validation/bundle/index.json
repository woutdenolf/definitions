 "types": {
  "ISO8601": {
   "base": "xs:dateTime",
   "builtins": [
    "xs:dateTime"
   ],
   "doc": "ISO8601 date/time stamp.\nIt is recommended to add an explicit time zone,\notherwise the local time zone *is assumed* per ISO8601.\nThe norm is that if there is no time zone, it is assumed\nlocal time, however, when a file moves from one country to\nanother it is undefined. If the local time zone is written,\nthe ambiguity is gone.",
   "members": [],
   "variety": "atomic"
  },
